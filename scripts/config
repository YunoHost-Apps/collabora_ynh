#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

# Apply Yunohost app's config
ynh_app_config_apply() {
   _ynh_app_config_apply

   if [[ "${changed[msfonts_enabled]}" == "true" && "$msfonts_enabled" == "true" ]]; then
      mscorefonts_activate
      coolconfig_update_system_template
   elif [[ "${changed[msfonts_enabled]}" == "true" && "$msfonts_enabled" == "false" ]]; then
      mscorefonts_desactivate
      coolconfig_update_system_template
   fi

   if [[ "${changed[dict_fr_enabled]}" == "true" && "$dict_fr_enabled" == "true" ]]; then
      frenchdict_activate
      coolconfig_update_system_template
   elif [[ "${changed[dict_fr_enabled]}" == "true" && "$dict_fr_enabled" == "false" ]]; then
      frenchdict_desactivate
      coolconfig_update_system_template
   fi

   if [[ "${changed[dict_de_enabled]}" == "true" && "$dict_de_enabled" == "true" ]]; then
      germandict_activate
      coolconfig_update_system_template
   elif [[ "${changed[dict_de_enabled]}" == "true" && "$dict_de_enabled" == "false" ]]; then
      germandict_desactivate
      coolconfig_update_system_template
   fi

   if [[ "${changed[dict_en_enabled]}" == "true" && "$dict_en_enabled" == "true" ]]; then
      englishdict_activate
      coolconfig_update_system_template
   elif [[ "${changed[dict_en_enabled]}" == "true" && "$dict_en_enabled" == "false" ]]; then
      englishdict_desactivate
      coolconfig_update_system_template
   fi

}

ynh_app_config_run $1